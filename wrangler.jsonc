{
  // Entry point and assets are passed by the deploy workflow, because the
  // build output folder can differ between environments (dist/ or .output/).
  "name": "fourat-portfolio",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  // Publie le worker sur un sous-domaine workers.dev (fourat-portfolio.<votre-sous-domaine>.workers.dev)
  "workers_dev": true,
  "preview_urls": false
}
